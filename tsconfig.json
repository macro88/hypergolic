{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/native/published-update-fixtures/**/*.tsx",
    "tests/native/feed-query/**/*.tsx",
    "tests/native/feed-subscription/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
