{
  "expo": {
    "name": "Hypergolic",
    "slug": "hypergolic",
    "version": "0.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "android": {
      "package": "org.nostrocket.hypergolic.dev"
    },
    "ios": {
      "bundleIdentifier": "org.nostrocket.hypergolic.dev"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "./plugins/withUnsignedRelease.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.4"
          }
        }
      ]
    ]
  }
}
