{
  "expo": {
    "name": "Hypergolic",
    "slug": "hypergolic",
    "version": "0.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "android": {
      "package": "org.nostrocket.hypergolic.dev",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "org.nostrocket.hypergolic.dev",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to approve identity backup and deletion."
      }
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "./plugins/withUnsignedRelease.cjs",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.4"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
