{
  "name": "hypergolic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "main": "index.ts",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "export:android": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "doctor:expo": "expo-doctor",
    "doctor:react": "react-doctor . --no-telemetry --no-supply-chain --yes --blocking warning",
    "doctor:slop": "node tools/quality/node_modules/aislop/dist/cli.js ci",
    "quality:install": "pnpm --dir tools/quality install --frozen-lockfile",
    "audit": "pnpm audit --audit-level=high && pnpm --dir tools/quality audit --audit-level=high",
    "check": "pnpm run typecheck && pnpm run doctor:expo && pnpm run doctor:react && pnpm run doctor:slop && pnpm run audit",
    "gsd:install": "gsd-core --codex --local"
  },
  "dependencies": {
    "expo": "57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@opengsd/gsd-core": "1.13.0",
    "@types/react": "19.2.4",
    "expo-doctor": "1.20.4",
    "react-doctor": "0.9.13",
    "typescript": "6.0.3"
  }
}
