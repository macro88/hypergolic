{
  "name": "hypergolic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "main": "index.ts",
  "engines": { "node": "24.20.0" },
  "overrides": { "xcode": { "uuid": "11.1.1" } },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "export:android": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "doctor:expo": "expo-doctor",
    "doctor:react": "react-doctor . --no-telemetry --no-supply-chain --yes --blocking warning",
    "doctor:slop": "node tools/quality/node_modules/aislop/dist/cli.js ci",
    "quality:install": "npm ci --prefix tools/quality",
    "audit": "npm audit --audit-level=high && npm audit --prefix tools/quality --audit-level=high",
    "check": "npm run typecheck && npm run doctor:expo && npm run doctor:react && npm run doctor:slop && npm run audit",
    "gsd:install": "gsd-core --codex --local"
  },
  "dependencies": {
    "expo": "57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@opengsd/gsd-core": "1.13.0",
    "@types/react": "19.2.4",
    "expo-doctor": "1.20.4",
    "react-doctor": "0.9.13",
    "typescript": "6.0.3"
  }
}
